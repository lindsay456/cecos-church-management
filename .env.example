# ---------------------------------------------------------------------------
# Ecclesia Gestion — Variables d'environnement
# Copier ce fichier en `.env` et adapter les valeurs.
# Ne JAMAIS committer le fichier `.env` réel.
# ---------------------------------------------------------------------------

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# --- Base de données ---
# Postgres en production ; vide => SQLite en développement simplifié
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://ecclesia:ecclesia@localhost:5432/ecclesia_gestion

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- CORS / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ecclesia-gestion.local

# --- Notifications ---
# True => les notifications Email/WhatsApp utilisent un provider factice local
USE_FAKE_NOTIFICATIONS=True

# --- API ---
API_BASE_URL=http://localhost:8000/api/v1
